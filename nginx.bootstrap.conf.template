server {
    listen 80;
    server_name ${API_DOMAIN};
    client_max_body_size 15m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ { proxy_pass http://backend:8080; include /etc/nginx/proxy_params; }
    location /files/ { proxy_pass http://backend:8080; include /etc/nginx/proxy_params; }
    location = /health { proxy_pass http://backend:8080/actuator/health; }
    location / { return 404; }
}
