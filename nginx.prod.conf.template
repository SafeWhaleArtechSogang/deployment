server {
    listen 80;
    server_name ${API_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name ${API_DOMAIN};
    client_max_body_size 15m;
    ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location /api/ { proxy_pass http://backend:8080; include /etc/nginx/proxy_params; }
    location /files/ { proxy_pass http://backend:8080; include /etc/nginx/proxy_params; }
    location = /health { proxy_pass http://backend:8080/actuator/health; }
    location / { return 404; }
}
