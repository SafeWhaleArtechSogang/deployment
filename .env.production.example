# GHCR 이미지: 최초 CI 발행 후 main 대신 검증한 커밋 SHA 태그 사용을 권장합니다.
BACKEND_IMAGE=ghcr.io/safewhaleartechsogang/backend:main
AI_IMAGE=ghcr.io/safewhaleartechsogang/ai-server:main

# DNS A 레코드가 이 EC2 공인 IP를 가리키는 API 도메인
API_DOMAIN=api.example.com
CERTBOT_EMAIL=team@example.com
NGINX_CONFIG=./nginx.bootstrap.conf.template

POSTGRES_DB=safewhale
POSTGRES_USER=safewhale
POSTGRES_PASSWORD=replace-with-long-random-password
JWT_SECRET=replace-with-base64-random-secret
AGENT_TOKEN=replace-with-random-agent-token
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GEMINI_API_KEY=replace-with-gemini-key

# Langfuse Cloud 추적 (선택). 키는 Langfuse 프로젝트 Settings → API Keys에서 발급한다.
# EU: https://cloud.langfuse.com / US: https://us.cloud.langfuse.com / Japan: https://jp.cloud.langfuse.com
# PROMPT_SOURCE=file 상태에서도 호출 추적은 동작한다.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-project-public-key
LANGFUSE_SECRET_KEY=sk-lf-replace-with-project-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_PREFIX=safewhale
LANGFUSE_TRACING=true
LANGFUSE_TRACING_ENVIRONMENT=prod
LANGFUSE_MASK_PII=true

# Vercel의 실제 Production 도메인만 허용한다. 여러 도메인은 쉼표로 구분한다.
CORS_ALLOWED_ORIGINS=https://app.example.com
MODEL_NAME=gemini-3.1-flash-lite
THINKING_LEVEL=low
AI_MEMORY_LIMIT=160m
